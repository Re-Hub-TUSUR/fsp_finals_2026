# ==============================================================================
# Sportikus — пример переменных окружения.
# Скопируйте в `.env` рядом с docker-compose.yml:  cp .env.example .env
# Файл `.env` в git не попадает.
# ==============================================================================

# ------------------------------------------------------------------------------
# Карты 2GIS — читает docker compose при сборке фронтенда и `npm run dev`
# ------------------------------------------------------------------------------
# Ключ 2GIS MapGL JS API (https://platform.2gis.ru). Без ключа приложение работает,
# но вместо карты показывается заглушка.
VITE_2GIS_KEY=
# ID своего стиля карты из редактора https://styles.2gis.com (пусто — стандартный стиль 2GIS)
VITE_2GIS_STYLE_ID=
# Тёмный стиль карты для тёмной темы интерфейса (пусто — карта остаётся светлой)
VITE_2GIS_STYLE_ID_DARK=

# ------------------------------------------------------------------------------
# Автопроверка мероприятий через ИИ (RouterAI) — читает docker compose и backend
# ------------------------------------------------------------------------------
# Ключ RouterAI (https://routerai.ru/settings/keys). Без ключа работает только фильтр запрещённых слов:
# сомнительные мероприятия публикуются с пометкой ⚠ для администратора.
ROUTERAI_API_KEY=
# Модель для проверки (быстрая и недорогая; можно заменить любой моделью из каталога https://routerai.ru/models)
MODERATION_LLM_MODEL=google/gemini-2.5-flash-lite

# ------------------------------------------------------------------------------
# Backend (Spring Boot)
# В docker-compose.yml эти значения заданы напрямую. Переменные ниже нужны только
# для запуска без Docker (`cd backend && mvn spring-boot:run`) — иначе действуют
# значения по умолчанию из application.yml.
# ------------------------------------------------------------------------------
# PostgreSQL обязательно с расширением PostGIS (в Docker — образ postgis/postgis:16-3.4-alpine)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sportikus
SPRING_DATASOURCE_USERNAME=sportikus_user
SPRING_DATASOURCE_PASSWORD=sportikus_password
# Ключ подписи JWT (не короче 32 байт). В реальном окружении обязательно замените.
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Каталог для загруженных фото профилей и логотипов (в Docker — volume profile_uploads → /app/uploads)
UPLOAD_DIR=uploads
# Задел под «Поделиться геопозицией»: код пока не подключён, флаг оставлен для будущего развития
FEATURES_LOCATION_SHARING_ENABLED=false

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------
# Адрес API. По умолчанию `/api/v1`: в Docker запросы проксирует nginx, в dev — Vite (proxy на localhost:8080).
# Задавайте только если API развёрнут на другом хосте.
# VITE_API_URL=http://localhost:8080/api/v1
